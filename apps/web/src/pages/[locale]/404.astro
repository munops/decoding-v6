---
import NotFoundPage from '../../components/NotFoundPage.astro'
import { localizedLocales, type Locale } from '../../i18n/catalog'
export function getStaticPaths() {
  return localizedLocales.map((locale) => ({ params: { locale }, props: { locale } }))
}
const { locale } = Astro.props as { locale: Locale }
---

<NotFoundPage locale={locale} />
