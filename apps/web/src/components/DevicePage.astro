---
import Layout from '../layouts/Layout.astro'
import WorkspaceManager from '../islands/WorkspaceManager'
import DataManager from '../islands/DataManager'
import CountControl from './CountControl.astro'
import { deviceMessages } from '../i18n/device'
import { localePath, type Locale } from '../i18n/catalog'
interface Props {
  locale: Locale
  page: 'workspace' | 'data' | 'offline'
}
const { locale, page } = Astro.props
const copy = deviceMessages[locale]
const title = copy[`${page}Title`]
---

<Layout locale={locale} title={`${title} — decod.ing`} alternatePath={`/${page}/`} noindex>
  <section class="page-hero container narrow"><h1>{title}</h1><p>{copy[`${page}Lead`]}</p></section>
  <div class="container">
    {
      page === 'workspace' ? (
        <WorkspaceManager client:only="preact" />
      ) : page === 'data' ? (
        <>
          <>
            <h2>{copy.counts}</h2>
            <p>{copy.countLead}</p>
            <CountControl locale={locale} />
            <DataManager client:load />
          </>
        </>
      ) : (
        <div class="inline-actions">
          <>
            <a class="button primary" href={localePath(locale)}>
              {copy.decoder}
            </a>
            <a class="button secondary" href={localePath(locale, '/tools/')}>
              {copy.tools}
            </a>
          </>
        </div>
      )
    }
  </div>
</Layout>
