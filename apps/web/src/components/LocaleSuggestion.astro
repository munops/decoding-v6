---
import { localeNames } from '../i18n/catalog'
interface Props {
  path: string
}
const { path } = Astro.props
---

<aside
  class="locale-suggestion"
  id="locale-suggestion"
  data-path={path}
  data-names={JSON.stringify(localeNames)}
  hidden
>
  <span
    ><span data-locale-prefix>Available in </span><strong data-locale-name></strong><span
      data-locale-suffix>.</span
    ></span
  >
  <a class="button primary small" data-locale-link>Open</a>
  <button class="button ghost small" type="button" data-locale-dismiss>Not now</button>
</aside>
<script>
  const suggestionCopy: Record<
    string,
    { prefix: string; suffix: string; open: string; dismiss: string }
  > = {
    ko: { prefix: '', suffix: '로 볼 수 있어요.', open: '한국어로 보기', dismiss: '영어로 계속' },
  }
  const suggestion = document.querySelector<HTMLElement>('#locale-suggestion')
  if (suggestion && !sessionStorage.getItem('decoding-locale-suggestion-dismissed')) {
    const languages = navigator.languages.length ? navigator.languages : [navigator.language]
    const locale = languages
      .map((language) => language.toLowerCase())
      .map((language) =>
        language.startsWith('ko')
          ? 'ko'
          : language.startsWith('ja')
            ? 'ja'
            : language.startsWith('zh')
              ? 'zh-cn'
              : language.startsWith('es')
                ? 'es'
                : language.startsWith('pt')
                  ? 'pt-br'
                  : language.startsWith('de')
                    ? 'de'
                    : language.startsWith('fr')
                      ? 'fr'
                      : undefined,
      )
      .find(Boolean)
    if (locale) {
      const names = JSON.parse(suggestion.dataset.names ?? '{}') as Record<string, string>
      const prefix = suggestion.querySelector<HTMLElement>('[data-locale-prefix]')
      const name = suggestion.querySelector<HTMLElement>('[data-locale-name]')
      const suffix = suggestion.querySelector<HTMLElement>('[data-locale-suffix]')
      const link = suggestion.querySelector<HTMLAnchorElement>('[data-locale-link]')
      const dismiss = suggestion.querySelector<HTMLButtonElement>('[data-locale-dismiss]')
      if (prefix && name && suffix && link && dismiss) {
        const copy = suggestionCopy[locale]
        if (copy) {
          prefix.textContent = copy.prefix
          suffix.textContent = copy.suffix
          link.textContent = copy.open
          dismiss.textContent = copy.dismiss
        }
        name.textContent = names[locale] ?? locale
        link.href = `/${locale}${suggestion.dataset.path ?? '/'}`
        link.hreflang = locale
        suggestion.lang = locale
        suggestion.hidden = false
        dismiss.addEventListener('click', () => {
          suggestion.hidden = true
          sessionStorage.setItem('decoding-locale-suggestion-dismissed', '1')
        })
      }
    }
  }
</script>
