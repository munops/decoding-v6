---
import { toolCopy } from '@decoding/workbench-ui'
import type { OperationDescriptor } from '@decoding/operations'
import { toolMessages } from '@decoding/workbench-ui'
import WebTool from '../islands/WebTool'
import Layout from '../layouts/Layout.astro'
import SponsorSlot from './SponsorSlot.astro'
import { localePath, toolPageMessages, type Locale } from '../i18n/catalog'
import { toolHelp } from '../i18n/tool-help'
import { deviceMessages } from '../i18n/device'
import { localizeOperation } from '../i18n/operations'

interface Props {
  locale: Locale
  operation: OperationDescriptor
}
const { locale, operation } = Astro.props
const messages = toolPageMessages[locale]
const displayOperation = localizeOperation(locale, operation)
const description = displayOperation.description
const help = toolHelp(locale, operation.id)
const helpCopy = deviceMessages[locale]
const routePath = `/${operation.id}/`
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: displayOperation.name,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web browser',
  inLanguage: locale,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
}
const boundary =
  operation.securityProfile === 'preview'
    ? messages.previewBoundary
    : operation.securityProfile === 'parser'
      ? messages.parserBoundary
      : messages.transformBoundary
---

<Layout
  ogKind="tool"
  locale={locale}
  title={`${displayOperation.name} — decod.ing`}
  description={description}
  alternatePath={routePath}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  <p class="container tool-decoder-link">
    <a href={locale === 'en' ? '/' : `/${locale}/`}>{toolCopy(locale).unknown}</a>
  </p>
  <section class="tool-hero container">
    <div>
      <a class="back-link" href={localePath(locale, '/tools/')}>{messages.back}</a>
      <span class="eyebrow">{messages.localUtility}</span>
      <h1>{displayOperation.name}</h1>
      <p>{description}</p>
    </div>
    <div class="tool-trust-card">
      <span class="privacy-dot"></span><strong>{messages.runsHere}</strong><p>
        {messages.trustBody}
      </p>
    </div>
  </section>
  <div class="container workbench-wrap">
    <WebTool
      operation={displayOperation}
      messages={toolMessages[locale]}
      locale={locale}
      client:load
    />
  </div>
  <SponsorSlot locale={locale} category={operation.category} />
  <section class="container tool-content">
    <article>
      <span class="eyebrow">{messages.howEyebrow}</span><h2>{messages.howTitle}</h2>
      <p>{displayOperation.description}</p>
      <h3>{helpCopy.whenToUse}</h3><p>{help.use}</p>
      <h3>{helpCopy.example}</h3><pre><code>{help.input}</code></pre><span aria-hidden="true"
        >↓</span
      ><pre><code>{help.output}</code></pre>
    </article>
    <article>
      <span class="eyebrow">{messages.boundaryEyebrow}</span><h2>{messages.boundaryTitle}</h2><p>
        {boundary}
      </p>
    </article>
  </section>
</Layout>
