---
import { answerMessages } from '@decoding/workbench-ui'
import { uiMessage } from '@decoding/workbench-ui'
import WebDecoder from '../islands/WebDecoder'
import Layout from '../layouts/Layout.astro'
import { type Locale } from '../i18n/catalog'
import { triageSamples } from '../lib/triage-samples'
import { decoderMessages } from '@decoding/workbench-ui'
import { operations } from '@decoding/operations'
import { localizeOperations } from '../i18n/operations'
import ToolShortcuts from './ToolShortcuts'
import RelatedGuides from './RelatedGuides.astro'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const copy = answerMessages(locale)
const samples = triageSamples.map((sample) => ({ ...sample, label: copy[sample.labelKey] }))
const shortcuts = localizeOperations(locale, operations).map(({ id, name }) => ({ id, name }))
---

<Layout locale={locale} title={copy.title} description={copy.lead} alternatePath="/">
  <section class="hero container">
    <div class="hero-copy">
      <h1>{copy.summary}</h1>
      <p>
        {copy.lead}
        <a href={locale === 'ko' ? '/ko/proof/' : '/proof/'}
          >{uiMessage(locale, 'check_local_processing')}</a
        >
      </p>
    </div>
  </section>
  <div class="container workbench-wrap">
    <WebDecoder
      messages={decoderMessages[locale]}
      sampleLabel={copy.examples}
      samples={samples}
      client:load
    />
  </div>
  <div class="container"><ToolShortcuts tools={shortcuts} locale={locale} client:load /></div>
  <RelatedGuides locale={locale} />
</Layout>
