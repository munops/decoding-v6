---
import WebDecoder from '../islands/WebDecoder'
import Layout from '../layouts/Layout.astro'
import { homeMessages, type Locale } from '../i18n/catalog'
import { triageSamples } from '../lib/triage-samples'
import { decoderMessages } from '@decoding/workbench-ui'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const messages = homeMessages[locale]
const [heading, accentHeading] = messages.heading.split('\n')
const samples = triageSamples.map((sample) => ({
  ...sample,
  label:
    sample.id === 'nested'
      ? messages.sampleNested
      : sample.id === 'ambiguous'
        ? messages.sampleAmbiguous
        : messages.sampleExpired,
}))
---

<Layout locale={locale} title={messages.title} description={messages.description} alternatePath="/">
  <section class="hero container">
    <div class="hero-copy">
      <span class="eyebrow hero-eyebrow">{messages.eyebrow}</span>
      <h1>{heading} <span>{accentHeading}</span></h1>
      <p>{messages.intro}</p>
      <div class="hero-proof">
        <span><strong>0</strong> {messages.uploaded}</span>
      </div>
    </div>
  </section>
  <div class="container workbench-wrap">
    <WebDecoder
      messages={decoderMessages[locale]}
      sampleLabel={messages.examplesLabel}
      samples={samples}
      client:only="preact"
    />
  </div>
</Layout>
