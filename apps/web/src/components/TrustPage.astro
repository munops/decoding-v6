---
import Layout from '../layouts/Layout.astro'
import { trustMessages, koreanTrustMessages, type TrustPageKey } from '../i18n/trust'

import type { Locale } from '../i18n/catalog'
import { publicOperator } from '../lib/public-operator'
interface Props {
  locale?: Locale
  page: TrustPageKey
}

const { page, locale = 'en' } = Astro.props
const content = locale === 'ko' ? koreanTrustMessages[page] : trustMessages[page]
---

<Layout locale={locale} title={content.title} description={content.description}>
  <article class="prose container">
    <span class="eyebrow">{content.eyebrow}</span><h1>{content.heading}</h1>
    <p>{publicOperator.name} ({publicOperator.koreanName}) · support@munops.com</p>
    <p class="lead">{content.lead}</p>
    {
      content.effectiveDate ? (
        <p>
          <strong>{content.effectiveDate}</strong>
        </p>
      ) : null
    }
    {
      content.sections.map((section) => (
        <>
          <h2>{section.heading}</h2>
          <p>{section.body}</p>
          {section.links?.length ? (
            <ul>
              {section.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          ) : null}
        </>
      ))
    }
  </article>
</Layout>
