---
import Layout from '../layouts/Layout.astro'
import { trustMessages, type TrustPageKey } from '../i18n/trust'

interface Props {
  page: TrustPageKey
}

const { page } = Astro.props
const content = trustMessages[page]
---

<Layout locale="en" title={content.title} description={content.description}>
  <article class="prose container">
    <span class="eyebrow">{content.eyebrow}</span><h1>{content.heading}</h1>
    <p class="lead">{content.lead}</p>
    {
      content.effectiveDate ? (
        <p>
          <strong>{content.effectiveDate}</strong>
        </p>
      ) : null
    }
    {
      content.sections.map((section) => (
        <>
          <h2>{section.heading}</h2>
          <p>{section.body}</p>
          {section.links?.length ? (
            <ul>
              {section.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          ) : null}
        </>
      ))
    }
  </article>
</Layout>
