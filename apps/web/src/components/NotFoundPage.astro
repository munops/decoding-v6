---
import Layout from '../layouts/Layout.astro'
import WebDecoder from '../islands/WebDecoder'
import { decoderMessages } from '@decoding/workbench-ui'
import { deviceMessages } from '../i18n/device'
import { localePath, type Locale } from '../i18n/catalog'
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const copy = deviceMessages[locale]
---

<Layout locale={locale} title={`${copy.notFoundTitle} — decod.ing`} noindex>
  <section class="page-hero container narrow">
    <span class="eyebrow">404</span><h1>{copy.notFoundTitle}</h1><p>{copy.notFoundLead}</p><a
      class="button secondary"
      href={localePath(locale, '/tools/')}>{copy.tools}</a
    >
  </section>
  <div class="container"><WebDecoder messages={decoderMessages[locale]} client:load /></div>
</Layout>
