---
import { uiMessage } from '@decoding/workbench-ui'
import { answerMessages } from '@decoding/workbench-ui'
import { publicOperator } from '../lib/public-operator'
import { buildRevision } from '../lib/build-info'
import { detectorSpecs } from '@decoding/spec-registry'
import UpdateBanner from '../components/UpdateBanner'
import '../styles/global.css'
import {
  layoutMessages,
  indexedLocales,
  localeNames,
  localePath,
  supportedLocales,
  type Locale,
} from '../i18n/catalog'
import LocalePreference from '../components/LocalePreference.astro'
import BrandMark from '../components/BrandMark.astro'
import CountControl from '../components/CountControl.astro'

interface Props {
  title?: string
  description?: string
  canonical?: string
  noindex?: boolean
  locale?: Locale
  alternatePath?: string
  englishPath?: string
  koreanPath?: string
  availableLocales?: readonly Locale[]
  ogKind?: 'home' | 'tool' | 'format'
}

const {
  locale = 'en',
  title = answerMessages(locale).title,
  description = answerMessages(locale).lead,
  availableLocales = supportedLocales,
  ogKind = 'home',
  canonical = Astro.url.pathname,
  noindex = false,
  alternatePath,
  englishPath,
} = Astro.props
const canonicalUrl = new URL(canonical, Astro.site)
const messages = layoutMessages[locale]
const navigation = answerMessages(locale)
const preventIndexing = noindex || !indexedLocales.includes(locale)
const translationPath = alternatePath ?? englishPath
const localizedHome = localePath(locale)
const localizedTools = localePath(locale, '/tools/')
const localizedMethod = localePath(locale, '/methodology/')
const localizedPrivacy = localePath(locale, '/privacy/')
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light dark" />
    <meta name="application-version" content="6.0.0" />
    <meta name="application-build" content={buildRevision} />
    <meta name="description" content={description} />
    {
      import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ? (
        <meta
          name="google-site-verification"
          content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      ) : null
    }
    {
      import.meta.env.PUBLIC_NAVER_SITE_VERIFICATION ? (
        <meta
          name="naver-site-verification"
          content={import.meta.env.PUBLIC_NAVER_SITE_VERIFICATION}
        />
      ) : null
    }
    {preventIndexing ? <meta name="robots" content="noindex,follow" /> : null}
    <link rel="canonical" href={canonicalUrl} />
    {
      translationPath
        ? indexedLocales.map((targetLocale) => (
            <link
              rel="alternate"
              hreflang={targetLocale}
              href={new URL(localePath(targetLocale, translationPath), Astro.site)}
            />
          ))
        : null
    }
    {
      translationPath ? (
        <link rel="alternate" hreflang="x-default" href={new URL(translationPath, Astro.site)} />
      ) : null
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta
      property="og:image"
      content={new URL(`/images/og/${ogKind}-${locale === 'ko' ? 'ko' : 'en'}.png`, Astro.site)}
    />
    <meta property="og:image:alt" content={title} />
    <meta
      name="twitter:image"
      content={new URL(`/images/og/${ogKind}-${locale === 'ko' ? 'ko' : 'en'}.png`, Astro.site)}
    />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem('decoding-theme')
        document.documentElement.dataset.theme = theme === 'dark' ? 'dark' : 'light'
        document.documentElement.dataset.textSize =
          localStorage.getItem('decoding-text-size') === 'large' ? 'large' : 'normal'
      } catch {
        document.documentElement.dataset.theme = 'light'
      }
    </script>
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: 'decod.ing',
        url: 'https://decod.ing',
        applicationCategory: 'UtilitiesApplication',
        operatingSystem: 'Web, macOS, Windows, Linux',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        description,
      })}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{messages.skip}</a>
    <header class="site-header">
      <a class="brand" href={localizedHome} aria-label={messages.home}>
        <BrandMark />
        <span class="brand-name">decod<span class="brand-dot">.</span>ing</span>
      </a>
      <nav aria-label={messages.primary}>
        <a href={localizedHome}>{navigation.decode}</a><a href={localizedTools}
          >{navigation.tools}</a
        ><a href={localePath(locale, '/workspace/')}>{navigation.saved}</a><a
          href={localePath(locale, '/more/')}>{navigation.more}</a
        >
      </nav>
      {
        translationPath ? (
          <details class="language-menu">
            <summary aria-label={messages.language}>{localeNames[locale]}</summary>
            <div class="language-options">
              {availableLocales.map((targetLocale) => (
                <a
                  href={localePath(targetLocale, translationPath)}
                  hreflang={targetLocale}
                  data-locale-choice={targetLocale}
                  lang={targetLocale}
                  aria-current={targetLocale === locale ? 'page' : undefined}
                >
                  {localeNames[targetLocale]}
                </a>
              ))}
            </div>
          </details>
        ) : null
      }
      {
        !indexedLocales.includes(locale) ? (
          <span class="translation-status">{messages.translationBeta}</span>
        ) : null
      }
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label={messages.theme}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <g class="theme-sun">
            <circle cx="12" cy="12" r="3.5"></circle>
            <path
              d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"
            ></path>
          </g>
          <path class="theme-moon" d="M19 15.3A7.5 7.5 0 0 1 8.7 5a7.5 7.5 0 1 0 10.3 10.3Z"></path>
        </svg>
      </button>
      <div class="header-trust"><span class="privacy-dot"></span> {messages.localOnly}</div>
    </header>
    <LocalePreference />
    <UpdateBanner locale={locale} client:load />
    <main id="main"><slot /></main>
    <nav class="bottom-tabs" aria-label={messages.primary}>
      <a
        href={localizedHome}
        aria-current={Astro.url.pathname === localizedHome ? 'page' : undefined}
        ><svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M3 11 12 3l9 8v10h-6v-7H9v7H3Z"></path></svg
        >{navigation.decode}</a
      >
      <a
        href={localizedTools}
        aria-current={Astro.url.pathname === localizedTools ? 'page' : undefined}
        ><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"></path></svg
        >{navigation.tools}</a
      >
      <a
        href={localePath(locale, '/workspace/')}
        aria-current={Astro.url.pathname.includes('/workspace/') ? 'page' : undefined}
        ><svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="m3 7 9-4 9 4-9 4Z M3 7v11l9 4 9-4V7 M12 11v11"></path></svg
        >{navigation.saved}</a
      >
      <a
        href={localePath(locale, '/more/')}
        aria-current={Astro.url.pathname.includes('/more/') ? 'page' : undefined}
        ><svg viewBox="0 0 24 24" aria-hidden="true"
          ><circle cx="5" cy="12" r="1"></circle><circle cx="12" cy="12" r="1"></circle><circle
            cx="19"
            cy="12"
            r="1"></circle></svg
        >{navigation.more}</a
      >
    </nav>
    <footer class="site-footer">
      <div>
        <a class="brand footer-brand" href={localizedHome}>
          <BrandMark />
          <span class="brand-name">decod<span class="brand-dot">.</span>ing</span>
        </a>
        <p>{navigation.footer}</p>
      </div>
      <div class="footer-links">
        <a href={localePath(locale, '/data/')}>{uiMessage(locale, 'device_data')}</a>
        <a href={locale === 'ko' ? '/ko/proof/' : '/proof/'}
          >{uiMessage(locale, 'check_local_processing')}</a
        >
        <a href="/bookmarklet/">Bookmarklet</a><a href="/sponsor/">{uiMessage(locale, 'sponsor')}</a
        >
        <a href={localizedTools}>47 {messages.tools}</a><a href={localizedPrivacy}
          >{messages.privacy}</a
        ><a href={locale === 'ko' ? '/ko/terms/' : '/terms/'}>{messages.terms}</a><a
          href={locale === 'ko' ? '/ko/support/' : '/support/'}>{messages.support}</a
        ><a href={localizedMethod}>{messages.method}</a><a href="/download/">{messages.desktop}</a
        ><a href="/changelog/">{messages.changelog}</a><a href={localePath(locale, '/about/')}
          >{messages.about}</a
        >
      </div>
      <CountControl locale={locale} />
      <p class="footer-note">
        {messages.footerNote} · {publicOperator.name} ({publicOperator.koreanName}) · Build {
          buildRevision.slice(0, 7)
        } · {detectorSpecs.length} formats
      </p>
    </footer>
    <script>
      import { countOpen, countReturn } from '../lib/telemetry'

      // 진입 즉시 1회. 라우트·동의·상호작용 뒤로 미루면 퍼널의 분모가 통째로 사라진다.
      // 보내는 것은 고정된 이벤트 이름 하나뿐이다 (apps/edge/src/index.ts 계약 참고).
      countOpen('app_open')
      countReturn()
      if (/^\/([a-z]{2}\/)?$/.test(location.pathname)) countOpen('landing_view')

      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        addEventListener('load', () => {
          void navigator.serviceWorker
            .register('/sw.js')
            .then(() => navigator.serviceWorker.ready)
            .then((registration) => {
              const cacheTools = () =>
                registration.active?.postMessage({
                  type: 'decoding:cache-tools',
                  locale: document.documentElement.lang,
                })
              if ('requestIdleCallback' in window) requestIdleCallback(cacheTools)
              else setTimeout(cacheTools, 1000)
            })
            .catch(() => {})
        })
      }

      const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle')
      const syncThemeToggle = () => {
        const activeTheme = document.documentElement.dataset.theme ?? 'light'
        themeToggle?.setAttribute('aria-pressed', String(activeTheme === 'dark'))
      }
      themeToggle?.addEventListener('click', () => {
        const activeTheme = document.documentElement.dataset.theme ?? 'light'
        const nextTheme = activeTheme === 'dark' ? 'light' : 'dark'
        document.documentElement.dataset.theme = nextTheme
        try {
          localStorage.setItem('decoding-theme', nextTheme)
        } catch {}
        syncThemeToggle()
      })
      syncThemeToggle()
    </script>
  </body>
</html>
