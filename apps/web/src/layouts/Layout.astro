---
import '../styles/global.css'
import {
  layoutMessages,
  indexedLocales,
  localeNames,
  localePath,
  supportedLocales,
  type Locale,
} from '../i18n/catalog'
import LocaleSuggestion from '../components/LocaleSuggestion.astro'
import BrandMark from '../components/BrandMark.astro'

interface Props {
  title?: string
  description?: string
  canonical?: string
  noindex?: boolean
  locale?: Locale
  alternatePath?: string
  englishPath?: string
  koreanPath?: string
}

const {
  title = 'decod.ing — Universal local decoder',
  description = 'Detect, decode, inspect, format, and convert developer data locally. 47 tools, no account, no upload.',
  canonical = Astro.url.pathname,
  noindex = false,
  locale = 'en',
  alternatePath,
  englishPath,
} = Astro.props
const canonicalUrl = new URL(canonical, Astro.site)
const messages = layoutMessages[locale]
const preventIndexing = noindex || !indexedLocales.includes(locale)
const translationPath = alternatePath ?? englishPath
const localizedHome = localePath(locale)
const localizedTools = localePath(locale, '/tools/')
const localizedMethod = localePath(locale, '/methodology/')
const localizedPrivacy = localePath(locale, '/privacy/')
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0c1423" />
    <meta name="color-scheme" content="light dark" />
    <meta name="application-version" content="6.0.0" />
    <meta name="description" content={description} />
    {preventIndexing ? <meta name="robots" content="noindex,follow" /> : null}
    <link rel="canonical" href={canonicalUrl} />
    {
      translationPath
        ? indexedLocales.map((targetLocale) => (
            <link
              rel="alternate"
              hreflang={targetLocale}
              href={new URL(localePath(targetLocale, translationPath), Astro.site)}
            />
          ))
        : null
    }
    {
      translationPath ? (
        <link rel="alternate" hreflang="x-default" href={new URL(translationPath, Astro.site)} />
      ) : null
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem('decoding-theme')
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme
      } catch {}
    </script>
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: 'decod.ing',
        url: 'https://decod.ing',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Web, macOS, Windows, Linux',
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
        description,
      })}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{messages.skip}</a>
    <header class="site-header">
      <a class="brand" href={localizedHome} aria-label={messages.home}>
        <BrandMark />
        <span class="brand-name">decod<span class="brand-dot">.</span>ing</span>
      </a>
      <nav aria-label={messages.primary}>
        <a href={localizedTools}>{messages.tools} <span class="nav-count">47</span></a>
        <a href={localizedMethod}>{messages.method}</a>
        <a href={localizedPrivacy}>{messages.privacy}</a>
        {locale === 'en' ? <a href="/workspace/">{messages.workspace}</a> : null}
        {locale === 'en' ? <a href="/download/">{messages.desktop}</a> : null}
      </nav>
      {
        translationPath ? (
          <details class="language-menu">
            <summary aria-label={messages.language}>{localeNames[locale]}</summary>
            <div class="language-options">
              {supportedLocales.map((targetLocale) => (
                <a
                  href={localePath(targetLocale, translationPath)}
                  hreflang={targetLocale}
                  lang={targetLocale}
                  aria-current={targetLocale === locale ? 'page' : undefined}
                >
                  {localeNames[targetLocale]}
                </a>
              ))}
            </div>
          </details>
        ) : null
      }
      {
        !indexedLocales.includes(locale) ? (
          <span class="translation-status">{messages.translationBeta}</span>
        ) : null
      }
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label={messages.theme}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <g class="theme-sun">
            <circle cx="12" cy="12" r="3.5"></circle>
            <path
              d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"
            ></path>
          </g>
          <path class="theme-moon" d="M19 15.3A7.5 7.5 0 0 1 8.7 5a7.5 7.5 0 1 0 10.3 10.3Z"></path>
        </svg>
      </button>
      <div class="header-trust"><span class="privacy-dot"></span> {messages.localOnly}</div>
    </header>
    {locale === 'en' && translationPath ? <LocaleSuggestion path={translationPath} /> : null}
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div>
        <a class="brand footer-brand" href={localizedHome}>
          <BrandMark />
          <span class="brand-name">decod<span class="brand-dot">.</span>ing</span>
        </a>
        <p>{messages.footer}</p>
      </div>
      <div class="footer-links">
        <a href={localizedTools}>47 {messages.tools}</a><a href={localizedPrivacy}
          >{messages.privacy}</a
        ><a href="/terms/">{messages.terms}</a><a href="/support/">{messages.support}</a><a
          href={localizedMethod}>{messages.method}</a
        ><a href="/changelog/">{messages.changelog}</a><a href={localePath(locale, '/about/')}
          >{messages.about}</a
        >
      </div>
      <p class="footer-note">{messages.footerNote}</p>
    </footer>
    <script>
      import { countOpen } from '../lib/telemetry'

      // 진입 즉시 1회. 라우트·동의·상호작용 뒤로 미루면 퍼널의 분모가 통째로 사라진다.
      // 보내는 것은 고정된 이벤트 이름 하나뿐이다 (apps/edge/src/index.ts 계약 참고).
      countOpen('app_open')
      if (/^\/([a-z]{2}\/)?$/.test(location.pathname)) countOpen('landing_view')

      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        addEventListener('load', () => navigator.serviceWorker.register('/sw.js'))
      }

      const themeToggle = document.querySelector<HTMLButtonElement>('#theme-toggle')
      const themeMedia = matchMedia('(prefers-color-scheme: dark)')
      const syncThemeToggle = () => {
        const activeTheme =
          document.documentElement.dataset.theme ?? (themeMedia.matches ? 'dark' : 'light')
        themeToggle?.setAttribute('aria-pressed', String(activeTheme === 'dark'))
      }
      themeToggle?.addEventListener('click', () => {
        const activeTheme =
          document.documentElement.dataset.theme ?? (themeMedia.matches ? 'dark' : 'light')
        const nextTheme = activeTheme === 'dark' ? 'light' : 'dark'
        document.documentElement.dataset.theme = nextTheme
        try {
          localStorage.setItem('decoding-theme', nextTheme)
        } catch {}
        syncThemeToggle()
      })
      themeMedia.addEventListener('change', syncThemeToggle)
      syncThemeToggle()
    </script>
  </body>
</html>
